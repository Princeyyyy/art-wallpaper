<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Isolated test logging: never write unit test logs or simulated exceptions to ~/.artwallpaper/logs -->
    <root level="warn">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
